// Main harvest initialization function
function initHarvestSection() {
    initHarvestCountdown();
    initParticipationModal();
    initAmountButtons();
    initProgressBars();
    initHarvestButtons();
}

// ===== HARVEST COUNTDOWN TIMER =====
function initHarvestCountdown() {
    const countdownElement = document.getElementById('harvest-countdown');
    if (!countdownElement) return;
    
    // Set harvest dates
    const childrenHarvestDate = new Date('2024-08-24T10:00:00').getTime();
    const adultHarvestDate = new Date('2025-11-16T10:30:00').getTime();
    
    function updateCountdown() {
        const now = new Date().getTime();
        
        // Determine which harvest to countdown to
        let targetDate, eventName, eventType;
        
        if (now < childrenHarvestDate) {
            targetDate = childrenHarvestDate;
            eventName = "Children's Harvest";
            eventType = "children";
        } else if (now < adultHarvestDate) {
            targetDate = adultHarvestDate;
            eventName = "Adult Harvest & Bazaar";
            eventType = "adult";
        } else {
            countdownElement.innerHTML = `
                <div class="countdown-ended">
                    <h3>Harvest Season Complete! 🎉</h3>
                    <p>Thank you for making our harvest celebrations wonderful!</p>
                </div>
            `;
            return;
        }
        
        const distance = targetDate - now;
        
        if (distance < 0) {
            updateCountdown();
            return;
        }
        
        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);
        
        countdownElement.innerHTML = `
            <div class="countdown-header-dynamic">
                <div class="event-badge ${eventType}">
                    <i class="fas ${eventType === 'children' ? 'fa-child' : 'fa-users'}"></i>
                    ${eventName}
                </div>
                <h4>Time Remaining</h4>
            </div>
            <div class="countdown-container">
                <div class="countdown-item">
                    <div class="countdown-number">${days}</div>
                    <div class="countdown-label">Days</div>
                </div>
                <div class="countdown-item">
                    <div class="countdown-number">${hours}</div>
                    <div class="countdown-label">Hours</div>
                </div>
                <div class="countdown-item">
                    <div class="countdown-number">${minutes}</div>
                    <div class="countdown-label">Minutes</div>
                </div>
                <div class="countdown-item">
                    <div class="countdown-number">${seconds}</div>
                    <div class="countdown-label">Seconds</div>
                </div>
            </div>
            <div class="next-harvest-info">
                ${eventType === 'children' ? 
                    '<p><i class="fas fa-calendar-alt"></i> Adult Harvest & Bazaar: November 16, 2025</p>' : 
                    '<p><i class="fas fa-heart"></i> Join us for this special celebration!</p>'
                }
            </div>
        `;
    }
    
    updateCountdown();
    setInterval(updateCountdown, 1000);
}

// ===== PARTICIPATION MODAL =====
function initParticipationModal() {
    const participateBtn = document.getElementById('participate-btn');
    const modal = document.getElementById('participation-modal');
    const closeBtn = document.getElementById('close-participation-modal');
    const cancelBtn = document.getElementById('cancel-participation');
    const form = document.getElementById('participation-form');
    
    if (!participateBtn || !modal) return;
    
    // Open modal
    participateBtn.addEventListener('click', () => {
        modal.style.display = 'block';
        document.body.style.overflow = 'hidden';
    });
    
    // Close modal
    function closeModal() {
        modal.style.display = 'none';
        document.body.style.overflow = 'auto';
        if (form) form.reset();
        resetFormVisibility();
    }
    
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
    
    // Close modal when clicking outside
    modal.addEventListener('click', (e) => {
        if (e.target === modal) {
            closeModal();
        }
    });
    
    // Handle form submission
    if (form) {
        form.addEventListener('submit', handleParticipationSubmission);
    }
    
    // Handle dynamic form fields
    initDynamicFormFields();
}

// ===== DYNAMIC FORM FIELDS =====
function initDynamicFormFields() {
    const participationCheckboxes = document.querySelectorAll('input[name="participation"]');
    
    participationCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', toggleFormSections);
    });
}

function toggleFormSections() {
    const participationTypes = Array.from(document.querySelectorAll('input[name="participation"]:checked'))
        .map(cb => cb.value);
    
    // Show/hide produce details
    const produceDetails = document.getElementById('produce-details');
    if (produceDetails) {
        produceDetails.style.display = participationTypes.includes('produce') ? 'block' : 'none';
    }
    
    // Show/hide volunteer details
    const volunteerDetails = document.getElementById('volunteer-details');
    if (volunteerDetails) {
        volunteerDetails.style.display = participationTypes.includes('volunteer') ? 'block' : 'none';
    }
    
    // Show/hide bazaar details
    const bazaarDetails = document.getElementById('bazaar-details');
    if (bazaarDetails) {
        bazaarDetails.style.display = participationTypes.includes('bazaar') ? 'block' : 'none';
    }
}

function resetFormVisibility() {
    const dynamicSections = ['produce-details', 'volunteer-details', 'bazaar-details'];
    dynamicSections.forEach(sectionId => {
        const section = document.getElementById(sectionId);
        if (section) section.style.display = 'none';
    });
}

// ===== FORM SUBMISSION HANDLER =====
function handleParticipationSubmission(e) {
    e.preventDefault();
    
    // Get form data
    const formData = new FormData(e.target);
    const participationData = {
        name: formData.get('participant-name'),
        email: formData.get('participant-email'),
        phone: formData.get('participant-phone'),
        participationTypes: [],
        produceType: formData.get('produce-type'),
        volunteerArea: formData.get('volunteer-area'),
        stallType: formData.get('stall-type'),
        specialRequests: formData.get('special-requests')
    };
    
    // Get selected participation types
    const checkedBoxes = document.querySelectorAll('input[name="participation"]:checked');
    checkedBoxes.forEach(box => {
        participationData.participationTypes.push(box.value);
    });
    
    // Validate required fields
    if (!participationData.name || !participationData.email || !participationData.phone) {
        showNotification('Please fill in all required fields', 'error');
        return;
    }
    
    if (participationData.participationTypes.length === 0) {
        showNotification('Please select at least one way to participate', 'error');
        return;
    }
    
    // Show loading state
    const submitBtn = e.target.querySelector('button[type="submit"]');
    const originalText = submitBtn.innerHTML;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
    submitBtn.disabled = true;
    
    // Simulate form submission
    setTimeout(() => {
        try {
            console.log('Participation data:', participationData);
            showNotification('Registration successful! We will contact you soon.', 'success');
            
            // Close modal and reset form
            document.getElementById('participation-modal').style.display = 'none';
            document.body.style.overflow = 'auto';
            e.target.reset();
            resetFormVisibility();
            
        } catch (error) {
            showNotification('Registration failed. Please try again.', 'error');
        } finally {
            // Reset button
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
        }
    }, 2000);
}

// ===== AMOUNT BUTTONS =====
function initAmountButtons() {
    const amountButtons = document.querySelectorAll('.amount-btn');
    
    amountButtons.forEach(button => {
        button.addEventListener('click', () => {
            // Remove active class from all buttons
            amountButtons.forEach(btn => btn.classList.remove('active'));
            
            // Add active class to clicked button
            button.classList.add('active');
            
            // Handle custom amount
            if (button.classList.contains('custom-amount')) {
                const customAmount = prompt('Enter your custom amount (₦):');
                if (customAmount && !isNaN(customAmount) && customAmount > 0) {
                    button.textContent = `₦${parseInt(customAmount).toLocaleString()}`;
                    button.dataset.amount = customAmount;
                } else {
                    button.classList.remove('active');
                }
            }
        });
    });
    
    // Handle donate button
    const donateBtn = document.querySelector('.donate-btn');
    if (donateBtn) {
        donateBtn.addEventListener('click', () => {
            const activeAmount = document.querySelector('.amount-btn.active');
            if (activeAmount) {
                const amount = activeAmount.dataset.amount;
                handleDonation(amount);
            } else {
                showNotification('Please select an amount to donate', 'warning');
            }
        });
    }
}

// ===== DONATION HANDLER =====
function handleDonation(amount) {
    showNotification(`Redirecting to payment gateway for ₦${parseInt(amount).toLocaleString()}...`, 'info');
    
    setTimeout(() => {
        const confirmed = confirm(`Proceed with donation of ₦${parseInt(amount).toLocaleString()}?`);
        if (confirmed) {
            showNotification('Thank you for your generous donation!', 'success');
        }
    }, 1500);
}

// ===== PROGRESS BARS ANIMATION =====
function initProgressBars() {
    const progressBars = document.querySelectorAll('.progress-fill');
    
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                const progressBar = entry.target;
                const targetProgress = progressBar.dataset.progress;
                
                setTimeout(() => {
                    progressBar.style.width = targetProgress + '%';
                }, 500);
                
                observer.unobserve(progressBar);
            }
        });
    }, { threshold: 0.5 });
    
    progressBars.forEach(bar => {
        observer.observe(bar);
    });
}

// ===== HARVEST BUTTONS =====
function initHarvestButtons() {
    // Volunteer button
    const volunteerBtn = document.querySelector('.volunteer-btn');
    if (volunteerBtn) {
        volunteerBtn.addEventListener('click', () => {
            const participateBtn = document.getElementById('participate-btn');
            if (participateBtn) {
                participateBtn.click();
                setTimeout(() => {
                    const volunteerCheckbox = document.querySelector('input[name="participation"][value="volunteer"]');
                    if (volunteerCheckbox) {
                        volunteerCheckbox.checked = true;
                        toggleFormSections();
                    }
                }, 100);
            }
        });
    }
    
    // Register stall button
    const registerBtn = document.querySelector('.register-btn');
    if (registerBtn) {
        registerBtn.addEventListener('click', () => {
            const participateBtn = document.getElementById('participate-btn');
            if (participateBtn) {
                participateBtn.click();
                setTimeout(() => {
                    const bazaarCheckbox = document.querySelector('input[name="participation"][value="bazaar"]');
                    if (bazaarCheckbox) {
                        bazaarCheckbox.checked = true;
                        toggleFormSections();
                    }
                }, 100);
            }
        });
    }
    
    // Donate harvest button
    const donateHarvestBtn = document.getElementById('donate-harvest-btn');
    if (donateHarvestBtn) {
        donateHarvestBtn.addEventListener('click', () => {
            const offeringsSection = document.querySelector('.harvest-offerings');
            if (offeringsSection) {
                offeringsSection.scrollIntoView({ 
                    behavior: 'smooth',
                    block: 'center'
                });
            }
        });
    }
}