// ===== READING CONTROLS =====
function initReadingControls() {
    // Audio buttons
    const audioButtons = document.querySelectorAll('.audio-btn');
    audioButtons.forEach(btn => {
        btn.addEventListener('click', function() {
            const readingType = this.getAttribute('data-reading');
            toggleAudio(readingType, this);
        });
    });

    // Expand buttons
    const expandButtons = document.querySelectorAll('.expand-btn');
    expandButtons.forEach(btn => {
        btn.addEventListener('click', function() {
            const readingType = this.getAttribute('data-reading');
            openReadingModal(readingType);
        });
    });

    // Action buttons
    document.getElementById('read-all-btn').addEventListener('click', readAllReadings);
    document.getElementById('download-readings-btn').addEventListener('click', downloadReadings);
    document.getElementById('share-readings-btn').addEventListener('click', shareReadings);
}

// ===== AUDIO FUNCTIONALITY =====
let currentAudio = null;
let currentAudioBtn = null;

function toggleAudio(readingType, button) {
    // Stop current audio if playing
    if (currentAudio && !currentAudio.paused) {
        currentAudio.pause();
        currentAudioBtn.classList.remove('playing');
        currentAudioBtn.innerHTML = '<i class="fas fa-play"></i>';
        
        if (currentAudioBtn === button) {
            currentAudio = null;
            currentAudioBtn = null;
            return;
        }
    }

    // Get reading text
    const readingText = getReadingText(readingType);
    
    // Use Web Speech API for text-to-speech
    if ('speechSynthesis' in window) {
        const utterance = new SpeechSynthesisUtterance(readingText);
        utterance.rate = 0.8;
        utterance.pitch = 1;
        utterance.volume = 1;
        
        utterance.onstart = () => {
            button.classList.add('playing');
            button.innerHTML = '<i class="fas fa-pause"></i>';
            currentAudioBtn = button;
        };
        
        utterance.onend = () => {
            button.classList.remove('playing');
            button.innerHTML = '<i class="fas fa-play"></i>';
            currentAudio = null;
            currentAudioBtn = null;
        };
        
        speechSynthesis.speak(utterance);
        currentAudio = { pause: () => speechSynthesis.cancel(), paused: false };
    } else {
        alert('Text-to-speech is not supported in your browser.');
    }
}

function getReadingText(readingType) {
    switch(readingType) {
        case 'first':
            return document.getElementById('first-reading-text').textContent;
        case 'psalm':
            return document.getElementById('psalm-response').textContent + ' ' + 
                   document.getElementById('psalm-text').textContent;
        case 'second':
            return document.getElementById('second-reading-text').textContent;
        case 'gospel':
            return document.getElementById('gospel-text').textContent;
        default:
            return '';
    }
}

// ===== READING MODAL =====
function initReadingModal() {
    const modal = document.getElementById('reading-modal');
    const closeBtn = document.getElementById('close-modal');
    
    closeBtn.addEventListener('click', closeReadingModal);
    
    modal.addEventListener('click', function(e) {
        if (e.target === modal) {
            closeReadingModal();
        }
    });
    
    // Modal buttons
    document.getElementById('modal-audio-btn').addEventListener('click', function() {
        const text = document.getElementById('modal-text').textContent;
        playModalAudio(text);
    });
    
    document.getElementById('modal-copy-btn').addEventListener('click', function() {
        const text = document.getElementById('modal-text').textContent;
        copyToClipboard(text);
    });
}

function openReadingModal(readingType) {
    const modal = document.getElementById('reading-modal');
    const title = document.getElementById('modal-reading-title');
    const reference = document.getElementById('modal-reference');
    const text = document.getElementById('modal-text');
    
    // Set modal content based on reading type
    switch(readingType) {
        case 'first':
            title.textContent = 'First Reading';
            reference.textContent = document.getElementById('first-reading-reference').textContent;
            text.textContent = document.getElementById('first-reading-text').textContent;
            break;
        case 'psalm':
            title.textContent = 'Responsorial Psalm';
            reference.textContent = document.getElementById('psalm-reference').textContent;
            text.textContent = document.getElementById('psalm-response').textContent + '\n\n' + 
                              document.getElementById('psalm-text').textContent;
            break;
        case 'second':
            title.textContent = 'Second Reading';
            reference.textContent = document.getElementById('second-reading-reference').textContent;
            text.textContent = document.getElementById('second-reading-text').textContent;
            break;
        case 'gospel':
            title.textContent = 'Gospel';
            reference.textContent = document.getElementById('gospel-reference').textContent;
            text.textContent = document.getElementById('gospel-text').textContent;
            break;
    }
    
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
}

function closeReadingModal() {
    const modal = document.getElementById('reading-modal');
    modal.classList.remove('active');
    document.body.style.overflow = 'auto';
}

function playModalAudio(text) {
    if ('speechSynthesis' in window) {
        speechSynthesis.cancel(); // Stop any current speech
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.rate = 0.8;
        speechSynthesis.speak(utterance);
    }
}

function copyToClipboard(text) {
    navigator.clipboard.writeText(text).then(() => {
        // Show success message
        showNotification('Text copied to clipboard!', 'success');
    }).catch(() => {
        // Fallback for older browsers
        const textArea = document.createElement('textarea');
        textArea.value = text;
        document.body.appendChild(textArea);
        textArea.select();
        document.execCommand('copy');
        document.body.removeChild(textArea);
        showNotification('Text copied to clipboard!', 'success');
    });
}

// ===== ACTION BUTTON FUNCTIONS =====
function readAllReadings() {
    const allReadings = [
        'First Reading: ' + document.getElementById('first-reading-reference').textContent + '. ' + 
        document.getElementById('first-reading-text').textContent,
        'Responsorial Psalm: ' + document.getElementById('psalm-reference').textContent + '. ' + 
        document.getElementById('psalm-response').textContent + ' ' + document.getElementById('psalm-text').textContent,
        'Second Reading: ' + document.getElementById('second-reading-reference').textContent + '. ' + 
        document.getElementById('second-reading-text').textContent,
        'Gospel: ' + document.getElementById('gospel-reference').textContent + '. ' + 
        document.getElementById('gospel-text').textContent
    ].join('\n\n');
    
    if ('speechSynthesis' in window) {
        speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(allReadings);
        utterance.rate = 0.8;
        speechSynthesis.speak(utterance);
        showNotification('Reading all scriptures...', 'info');
    }
}

function downloadReadings() {
    const readings = {
        date: new Date().toLocaleDateString(),
        firstReading: {
            reference: document.getElementById('first-reading-reference').textContent,
            text: document.getElementById('first-reading-text').textContent
        },
        psalm: {
            reference: document.getElementById('psalm-reference').textContent,
            response: document.getElementById('psalm-response').textContent,
            text: document.getElementById('psalm-text').textContent
        },
        secondReading: {
            reference: document.getElementById('second-reading-reference').textContent,
            text: document.getElementById('second-reading-text').textContent
        },
        gospel: {
            reference: document.getElementById('gospel-reference').textContent,
            text: document.getElementById('gospel-text').textContent
        },
        reflection: document.getElementById('daily-reflection').textContent
    };
    
    const content = formatReadingsForDownload(readings);
    downloadTextFile(content, `Daily_Readings_${new Date().toISOString().split('T')[0]}.txt`);
}

function formatReadingsForDownload(readings) {
    return `DAILY READINGS - ${readings.date}
    
FIRST READING
${readings.firstReading.reference}
${readings.firstReading.text}

RESPONSORIAL PSALM
${readings.psalm.reference}
Response: ${readings.psalm.response}
${readings.psalm.text}

SECOND READING
${readings.secondReading.reference}
${readings.secondReading.text}

GOSPEL
${readings.gospel.reference}
${readings.gospel.text}

REFLECTION
${readings.reflection}

---
Our Lady Mother and Queen Catholic Church, Badore
`;
}

// Continue from downloadTextFile function

function downloadTextFile(content, filename) {
    const blob = new Blob([content], { type: 'text/plain' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    window.URL.revokeObjectURL(url);
    showNotification('Readings downloaded successfully!', 'success');
}

function shareReadings() {
    const readingsText = `Today's Catholic Readings - ${new Date().toLocaleDateString()}

First Reading: ${document.getElementById('first-reading-reference').textContent}
Gospel: ${document.getElementById('gospel-reference').textContent}

Join us for Mass at Our Lady Mother and Queen Catholic Church, Badore
Visit: ${window.location.origin}`;

    if (navigator.share) {
        navigator.share({
            title: 'Today\'s Catholic Readings',
            text: readingsText,
            url: window.location.href
        }).then(() => {
            showNotification('Readings shared successfully!', 'success');
        }).catch(() => {
            fallbackShare(readingsText);
        });
    } else {
        fallbackShare(readingsText);
    }
}

function fallbackShare(text) {
    // Copy to clipboard as fallback
    copyToClipboard(text);
    showNotification('Readings copied to clipboard for sharing!', 'info');
}

// ===== NOTIFICATION SYSTEM =====
function showNotification(message, type = 'info') {
    // Remove existing notifications
    const existingNotifications = document.querySelectorAll('.notification');
    existingNotifications.forEach(notification => notification.remove());
    
    const notification = document.createElement('div');
    notification.className = `notification notification-${type}`;
    notification.innerHTML = `
        <div class="notification-content">
            <i class="fas ${getNotificationIcon(type)}"></i>
            <span>${message}</span>
        </div>
        <button class="notification-close">
            <i class="fas fa-times"></i>
        </button>
    `;
    
    document.body.appendChild(notification);
    
    // Add styles if not already added
    if (!document.querySelector('#notification-styles')) {
        addNotificationStyles();
    }
    
    // Show notification
    setTimeout(() => notification.classList.add('show'), 100);
    
    // Auto hide after 5 seconds
    setTimeout(() => {
        notification.classList.remove('show');
        setTimeout(() => notification.remove(), 300);
    }, 5000);
    
    // Close button functionality
    notification.querySelector('.notification-close').addEventListener('click', () => {
        notification.classList.remove('show');
        setTimeout(() => notification.remove(), 300);
    });
}

function getNotificationIcon(type) {
    switch(type) {
        case 'success': return 'fa-check-circle';
        case 'error': return 'fa-exclamation-circle';
        case 'warning': return 'fa-exclamation-triangle';
        default: return 'fa-info-circle';
    }
}

function addNotificationStyles() {
    const style = document.createElement('style');
    style.id = 'notification-styles';
    style.textContent = `
        .notification {
            position: fixed;
            top: 20px;
            right: 20px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            padding: 15px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            z-index: 10000;
            transform: translateX(400px);
            transition: transform 0.3s ease;
            max-width: 350px;
            border-left: 4px solid #3498db;
        }
        
        .notification.show {
            transform: translateX(0);
        }
        
        .notification-success {
            border-left-color: #27ae60;
        }
        
        .notification-error {
            border-left-color: #e74c3c;
        }
        
        .notification-warning {
            border-left-color: #f39c12;
        }
        
        .notification-content {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .notification-content i {
            font-size: 18px;
        }
        
        .notification-success .notification-content i {
            color: #27ae60;
        }
        
        .notification-error .notification-content i {
            color: #e74c3c;
        }
        
        .notification-warning .notification-content i {
            color: #f39c12;
        }
        
        .notification-info .notification-content i {
            color: #3498db;
        }
        
        .notification-close {
            background: none;
            border: none;
            cursor: pointer;
            color: #7f8c8d;
            font-size: 14px;
            padding: 5px;
            border-radius: 50%;
            transition: all 0.3s ease;
        }
        
        .notification-close:hover {
            background: #ecf0f1;
            color: #2c3e50;
        }
        
        @media (max-width: 480px) {
            .notification {
                right: 10px;
                left: 10px;
                max-width: none;
                transform: translateY(-100px);
            }
            
            .notification.show {
                transform: translateY(0);
            }
        }
    `;
    document.head.appendChild(style);
}

// ===== READINGS ANIMATION EFFECTS =====
function initReadingsAnimations() {
    // Stagger animation for reading cards
    const readingCards = document.querySelectorAll('.reading-card');
    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry, index) => {
            if (entry.isIntersecting) {
                setTimeout(() => {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }, index * 150);
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.2 });

    readingCards.forEach(card => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(30px)';
        card.style.transition = 'all 0.6s ease';
        observer.observe(card);
    });

    // Liturgical info animation
    const liturgicalInfo = document.querySelector('.liturgical-info');
    if (liturgicalInfo) {
        const infoObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.animation = 'slideInFromTop 0.8s ease-out forwards';
                    infoObserver.unobserve(entry.target);
                }
            });
        }, { threshold: 0.5 });
        
        liturgicalInfo.style.opacity = '0';
        liturgicalInfo.style.transform = 'translateY(-30px)';
        infoObserver.observe(liturgicalInfo);
    }
}

// Add CSS animations for readings
function addReadingsAnimations() {
    const style = document.createElement('style');
    style.textContent = `
        @keyframes slideInFromTop {
            from {
                opacity: 0;
                transform: translateY(-30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        @keyframes readingCardHover {
            0% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-5px) scale(1.02); }
            100% { transform: translateY(-10px) scale(1); }
        }
        
        .reading-card:hover {
            animation: readingCardHover 0.3s ease-out forwards;
        }
        
        @keyframes liturgicalPulse {
            0%, 100% { 
                box-shadow: 0 0 0 0 rgba(var(--liturgical-color-rgb), 0.4);
            }
            50% { 
                box-shadow: 0 0 0 20px rgba(var(--liturgical-color-rgb), 0);
            }
        }
        
        .liturgical-info::before {
            animation: liturgicalPulse 3s ease-in-out infinite;
        }
        
        @keyframes textShimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }
        
        .reading-text {
            background: linear-gradient(90deg, transparent, rgba(52, 152, 219, 0.1), transparent);
            background-size: 200% 100%;
            animation: textShimmer 3s ease-in-out infinite;
        }
        
        .gospel .reading-text {
            background: linear-gradient(90deg, transparent, rgba(231, 76, 60, 0.1), transparent);
            background-size: 200% 100%;
        }
        
        .psalm .reading-text {
            background: linear-gradient(90deg, transparent, rgba(243, 156, 18, 0.1), transparent);
            background-size: 200% 100%;
        }
    `;
    document.head.appendChild(style);
}

// ===== KEYBOARD SHORTCUTS =====
function initReadingsKeyboardShortcuts() {
    document.addEventListener('keydown', function(e) {
        // Only activate shortcuts when not typing in input fields
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
        
        switch(e.key) {
            case '1':
                if (e.ctrlKey) {
                    e.preventDefault();
                    openReadingModal('first');
                }
                break;
            case '2':
                if (e.ctrlKey) {
                    e.preventDefault();
                    openReadingModal('psalm');
                }
                break;
            case '3':
                if (e.ctrlKey) {
                    e.preventDefault();
                    openReadingModal('second');
                }
                break;
            case '4':
                if (e.ctrlKey) {
                    e.preventDefault();
                    openReadingModal('gospel');
                }
                break;
            case 'Escape':
                closeReadingModal();
                break;
            case ' ':
                if (e.ctrlKey) {
                    e.preventDefault();
                    readAllReadings();
                }
                break;
        }
    });
}

