// ===== DAILY READINGS FUNCTIONALITY =====
function initDailyReadings() {
    updateLiturgicalInfo();
    loadDailyReadings();
    initReadingControls();
    initReadingModal();
}

// ===== LITURGICAL CALENDAR =====
function updateLiturgicalInfo() {
    const today = new Date();
    const liturgicalData = getLiturgicalData(today);
    
    // Update liturgical season
    document.getElementById('liturgical-season').textContent = liturgicalData.season;
    document.getElementById('liturgical-week').textContent = liturgicalData.week;
    document.getElementById('season-icon').className = `fas ${liturgicalData.icon}`;
    
    // Update date
    document.getElementById('liturgical-date').textContent = today.toLocaleDateString('en-US', {
        weekday: 'long',
        year: 'numeric',
        month: 'long',
        day: 'numeric'
    });
    document.getElementById('liturgical-day').textContent = liturgicalData.celebration;
    
    // Update liturgical color
    document.getElementById('liturgical-color-name').textContent = liturgicalData.color.name;
    document.getElementById('liturgical-color-indicator').style.background = liturgicalData.color.hex;
    
    // Set CSS custom property for liturgical color
    document.documentElement.style.setProperty('--liturgical-color', liturgicalData.color.hex);
}

function getLiturgicalData(date) {
    // Simplified liturgical calendar logic
    const month = date.getMonth() + 1;
    const day = date.getDate();
    
    // This is a simplified version - in production, you'd use a proper liturgical calendar API
    if (month === 12 && day >= 1 && day <= 24) {
        return {
            season: 'Advent',
            week: `Week ${Math.ceil(day / 7)}`,
            celebration: 'Weekday of Advent',
            icon: 'fa-star',
            color: { name: 'Purple', hex: '#663399' }
        };
    } else if (month === 12 && day >= 25 || month === 1 && day <= 6) {
        return {
            season: 'Christmas',
            week: 'Christmas Season',
            celebration: 'Christmas Time',
            icon: 'fa-baby',
            color: { name: 'White', hex: '#ffffff' }
        };
    } else if (month >= 2 && month <= 4) {
        return {
            season: 'Lent',
            week: `Week ${Math.ceil(day / 7)} of Lent`,
            celebration: 'Weekday of Lent',
            icon: 'fa-cross',
            color: { name: 'Purple', hex: '#663399' }
        };
    } else if (month === 4 && day >= 15) {
        return {
            season: 'Easter',
            week: 'Easter Season',
            celebration: 'Easter Time',
            icon: 'fa-dove',
            color: { name: 'White', hex: '#ffffff' }
        };
    } else {
        return {
            season: 'Ordinary Time',
            week: `Week ${Math.ceil(day / 7)}`,
            celebration: 'Weekday in Ordinary Time',
            icon: 'fa-leaf',
            color: { name: 'Green', hex: '#28a745' }
        };
    }
}

// ===== LOAD DAILY READINGS =====
