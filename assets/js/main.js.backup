// ===== ANIMATED COUNTERS =====
function initAnimatedCounters() {
    const counters = document.querySelectorAll('.stat-number');
    const observerOptions = {
        threshold: 0.7
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                const counter = entry.target;
                const target = parseInt(counter.getAttribute('data-count'));
                const duration = 2000; // 2 seconds
                const step = target / (duration / 16); // 60fps
                let current = 0;

                const updateCounter = () => {
                    current += step;
                    if (current < target) {
                        counter.textContent = Math.floor(current);
                        requestAnimationFrame(updateCounter);
                    } else {
                        counter.textContent = target;
                    }
                };

                updateCounter();
                observer.unobserve(counter);
            }
        });
    }, observerOptions);

    counters.forEach(counter => {
        observer.observe(counter);
    });
}

// ===== LEADERSHIP CARD INTERACTIONS =====
// Continue from leadership card interactions

function initLeadershipCards() {
    const leaderCards = document.querySelectorAll('.leader-card');
    
    leaderCards.forEach(card => {
        card.addEventListener('mouseenter', () => {
            // Add subtle animation to other cards
            leaderCards.forEach(otherCard => {
                if (otherCard !== card) {
                    otherCard.style.opacity = '0.7';
                    otherCard.style.transform = 'scale(0.95)';
                }
            });
        });
        
        card.addEventListener('mouseleave', () => {
            // Reset all cards
            leaderCards.forEach(otherCard => {
                otherCard.style.opacity = '1';
                otherCard.style.transform = 'scale(1)';
            });
        });
    });
}

// ===== VALUE ITEMS STAGGER ANIMATION =====
function initValueItemsAnimation() {
    const valueItems = document.querySelectorAll('.value-item');
    
    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry, index) => {
            if (entry.isIntersecting) {
                setTimeout(() => {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateX(0)';
                }, index * 100);
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.5 });

    valueItems.forEach(item => {
        item.style.opacity = '0';
        item.style.transform = 'translateX(-30px)';
        item.style.transition = 'all 0.6s ease';
        observer.observe(item);
    });
}

// ===== TIMELINE PREVIEW ANIMATION =====
function initTimelineAnimation() {
    const timelineItems = document.querySelectorAll('.timeline-item');
    
    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry, index) => {
            if (entry.isIntersecting) {
                setTimeout(() => {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                    
                    // Animate the year circle
                    const yearCircle = entry.target.querySelector('.timeline-year');
                    yearCircle.style.animation = 'pulse-glow 0.6s ease-out';
                }, index * 200);
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.5 });

    timelineItems.forEach(item => {
        item.style.opacity = '0';
        item.style.transform = 'translateY(30px)';
        item.style.transition = 'all 0.6s ease';
        observer.observe(item);
    });
}

// ===== FLOATING ELEMENTS ANIMATION =====
function initFloatingElements() {
    const floatingCross = document.querySelector('.floating-cross');
    const floatingDove = document.querySelector('.floating-dove');
    
    if (floatingCross && floatingDove) {
        // Add random movement to floating elements
        setInterval(() => {
            const randomX = Math.random() * 20 - 10;
            const randomY = Math.random() * 20 - 10;
            
            floatingCross.style.transform = `translate(${randomX}px, ${randomY}px) rotate(${Math.random() * 10 - 5}deg)`;
        }, 3000);
        
        setInterval(() => {
            const randomX = Math.random() * 20 - 10;
            const randomY = Math.random() * 20 - 10;
            
            floatingDove.style.transform = `translate(${randomX}px, ${randomY}px) rotate(${Math.random() * 10 - 5}deg)`;
        }, 4000);
    }
}

// ===== PARALLAX EFFECT FOR ABOUT SECTION =====
function initAboutParallax() {
    const aboutSection = document.querySelector('.about-section');
    const floatingElements = document.querySelector('.floating-elements');
    
    if (aboutSection && floatingElements) {
        window.addEventListener('scroll', () => {
            const scrolled = window.pageYOffset;
            const sectionTop = aboutSection.offsetTop;
            const sectionHeight = aboutSection.offsetHeight;
            const windowHeight = window.innerHeight;
            
            // Check if section is in viewport
            if (scrolled + windowHeight > sectionTop && scrolled < sectionTop + sectionHeight) {
                const parallaxSpeed = (scrolled - sectionTop) * 0.1;
                floatingElements.style.transform = `translateY(${parallaxSpeed}px)`;
            }
        });
    }
}

// ===== MISSION/VISION CARDS REVEAL ANIMATION =====
function initMissionVisionCards() {
    const missionCard = document.querySelector('.mission-card');
    const visionCard = document.querySelector('.vision-card');
    
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                if (entry.target.classList.contains('mission-card')) {
                    entry.target.style.animation = 'slideInLeft 0.8s ease-out forwards';
                } else if (entry.target.classList.contains('vision-card')) {
                    entry.target.style.animation = 'slideInRight 0.8s ease-out forwards';
                }
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.3 });

    if (missionCard) {
        missionCard.style.opacity = '0';
        missionCard.style.transform = 'translateX(-50px)';
        observer.observe(missionCard);
    }
    
    if (visionCard) {
        visionCard.style.opacity = '0';
        visionCard.style.transform = 'translateX(50px)';
        observer.observe(visionCard);
    }
}

// Add CSS animations dynamically
function addAboutAnimations() {
    const style = document.createElement('style');
    style.textContent = `
        @keyframes pulse-glow {
            0% {
                box-shadow: 0 0 0 0 rgba(52, 152, 219, 0.7);
            }
            70% {
                box-shadow: 0 0 0 20px rgba(52, 152, 219, 0);
            }
            100% {
                box-shadow: 0 0 0 0 rgba(52, 152, 219, 0);
            }
        }
        
        @keyframes slideInLeft {
            from {
                opacity: 0;
                transform: translateX(-50px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }
        
        @keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(50px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }
        
        @keyframes shimmer-about {
            0% {
                background-position: -200% 0;
            }
            100% {
                background-position: 200% 0;
            }
        }
        
        .primary-btn::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.5s ease;
        }
        
        .primary-btn:hover::after {
            left: 100%;
        }
    `;
    document.head.appendChild(style);
}

